@using Core.Models.Entities.Customer
@model CustomerResponseModel

@{
    ViewData["Title"] = "Customer Delete";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="col-md-12">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">Customer Delete</h3>
            </div>

            <div class="card-body">
                <h5>Silmek istediğine emin misin?</h5>

                <label>Müşteri Tipi</label>
                <input class="form-control"
                       value="@(Model.CustomerType == 1 ? "Bireysel" :
                                                      Model.CustomerType == 2 ? "Kurumsal" : "Belirsiz")"
                       disabled />

                @if (Model.CustomerType == 1)
                {
                    <label>Ad Soyad</label>
                    <input class="form-control" value="@Model.FirstName @Model.LastName" disabled />

                    <label>TCKN</label>
                    <input class="form-control" value="@Model.TCKN" disabled />
                }
                else if (Model.CustomerType == 2)
                {
                    <label>Firma Adı</label>
                    <input class="form-control" value="@Model.CompanyName" disabled />

                    <label>Vergi Dairesi</label>
                    <input class="form-control" value="@Model.TaxOffice" disabled />

                    <label>Vergi No</label>
                    <input class="form-control" value="@Model.TaxNumber" disabled />
                }

                <label>Email</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="card-footer">
                <button class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</form>