@using Core.Models.Entities.Customer
@model CustomerResponseModel

@{
    ViewData["Title"] = "Customer Detail";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <h3 class="card-title">Customer Detail</h3>
    </div>

    <div class="card-body">

        <label>Customer Type</label>
        <input class="form-control"
               value="@(Model.CustomerType == 1 ? "Bireysel" : "Kurumsal")"
               disabled />

        <label>Email</label>
        <input class="form-control" value="@Model.Email" disabled />

        <label>Phone</label>
        <input class="form-control" value="@Model.PhoneNumber" disabled />

        <label>City</label>
        <input class="form-control" value="@Model.City" disabled />

        <label>Address</label>
        <input class="form-control" value="@Model.AddressLine1" disabled />

    </div>
</div>
