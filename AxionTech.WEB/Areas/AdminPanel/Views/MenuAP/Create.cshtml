@using Core.Models.Entities.Menu
@model CreateMenuRequestModel

@{
    ViewData["Title"] = "Create Menu";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">

    <div class="card-header">
        <h3 class="card-title">Create Menu</h3>
    </div>

    <form method="post" action="~/AdminPanel/MenuAP/Create">

        <div class="card-body">

            <div class="form-group">
                <label>Controller Name</label>

                <input name="ControllerName"
                       class="form-control"
                       placeholder="Example: ProductAP" />
            </div>

            <div class="form-group">
                <label>View Name</label>

                <input name="ViewName"
                       class="form-control"
                       placeholder="Example: List" />
            </div>

            <div class="form-group">
                <label>Parent Id</label>

                <input name="ParentId"
                       type="number"
                       class="form-control"
                       value="0" />
            </div>

            <div class="form-group">
                <label>Status</label>

                <select name="IsActive" class="form-control">

                    <option value="true">
                        Active
                    </option>

                    <option value="false">
                        Passive
                    </option>

                </select>

            </div>

        </div>

        <div class="card-footer">
            <button class="btn btn-success">
                Create
            </button>
        </div>

    </form>

</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-2">
        @ViewBag.Error
    </div>
}