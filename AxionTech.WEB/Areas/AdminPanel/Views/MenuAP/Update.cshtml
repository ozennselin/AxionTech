@using Core.Models.Entities.Menu
@model MenuResponseModel

@{
    ViewData["Title"] = "Update Menu";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-warning">

    <div class="card-header">
        <h3 class="card-title">
            Update Menu
        </h3>
    </div>

    <form method="post" action="~/AdminPanel/MenuAP/Update">

        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div class="card-body">

            <div class="form-group">

                <label>Controller Name</label>

                <input name="ControllerName"
                       value="@Model.ControllerName"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label>View Name</label>

                <input name="ViewName"
                       value="@Model.ViewName"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label>Parent Id</label>

                <input name="ParentId"
                       value="@Model.ParentId"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label>Status</label>

                <select name="IsActive"
                        class="form-control">

                    <option value="true"
                        @(Model.IsActive ? "selected" : null)>

                        Active

                    </option>

                    <option value="false"
                        @(!Model.IsActive ? "selected" : null)>

                        Passive

                    </option>

                </select>

            </div>

        </div>

        <div class="card-footer">

            <button class="btn btn-warning">
                Update
            </button>

        </div>

    </form>

</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-2">
        @ViewBag.Error
    </div>
}