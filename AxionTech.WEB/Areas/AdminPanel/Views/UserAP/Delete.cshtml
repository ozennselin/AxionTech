@using Core.Models.Entities.User
@model UserResponseModel

@{
    ViewData["Title"] = "User Delete";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="col-md-12">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">User Delete</h3>
            </div>

            <div class="card-body">
                <h5>Silmek istediğine emin misin?</h5>

                <label>UserName</label>
                <input class="form-control" value="@Model.UserName" disabled />

                <label>Email</label>
                <input class="form-control" value="@Model.Email" disabled />

                <label>Ad Soyad</label>
                <input class="form-control" value="@Model.FirstName @Model.LastName" disabled />
            </div>

            <div class="card-footer">
                <button class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</form>
