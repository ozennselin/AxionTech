@using Core.Models.Entities.User
@model List<UserResponseModel>

@{
    ViewData["Title"] = "User List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">

        <div class="text-xl-left">
            <h3 class="card-title">User List</h3>
        </div>

        <div class="text-md-right">
            <a class="btn btn-success" href="~/AdminPanel/UserAP/Create">
                Create
            </a>
        </div>

    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>UserName</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Ad Soyad</th>
                    <th>Aktif</th>
                    <th>Detail</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserName</td>
                            <td>@item.Email</td>
                            <td>@item.RoleName</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@(item.IsActive ? "Aktif" : "Pasif")</td>

                            <td>
                                <a class="btn btn-block btn-primary btn-sm"
                                   href="~/AdminPanel/UserAP/Detail/@item.Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-warning btn-sm"
                                   href="~/AdminPanel/UserAP/Update/@item.Id">
                                    <i class="fa fa-pen"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-danger btn-sm"
                                   href="~/AdminPanel/UserAP/Delete/@item.Id">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-danger">
                            Kayıt bulunamadı
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>