@using Core.Models.Entities.ProductPrice
@model List<ProductPriceResponseModel>

@{
    ViewData["Title"] = "Product Price List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <h3 class="card-title">Product Price List</h3>
            <a class="btn btn-success" href="~/AdminPanel/ProductPriceAP/Create">Create</a>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Product Id</th>
                    <th>Price</th>
                    <th>Description</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ProductId</td>
                            <td>@item.Price</td>
                            <td>@item.Description</td>

                            <td>
                                <a class="btn btn-block btn-warning btn-sm"
                                   href="~/AdminPanel/ProductPriceAP/Update/@item.ProductId">
                                    <i class="fa fa-pen"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-danger btn-sm"
                                   href="~/AdminPanel/ProductPriceAP/Delete/@item.ProductId">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-danger">
                            No records found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>