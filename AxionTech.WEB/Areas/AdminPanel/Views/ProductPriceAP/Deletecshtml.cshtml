@using Core.Models.Entities.ProductPrice
@model ProductPriceResponseModel

@{
    ViewData["Title"] = "Delete Product Price";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<form method="post" action="~/AdminPanel/ProductPriceAP/Delete">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card card-danger">
        <div class="card-header">
            <h3 class="card-title">Delete Product Price</h3>
        </div>

        <div class="card-body">
            <div class="form-group">
                <label>Product Id</label>
                <input class="form-control" value="@Model.ProductId" disabled />
            </div>

            <div class="form-group">
                <label>Price</label>
                <input class="form-control" value="@Model.Price" disabled />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea class="form-control" rows="3" disabled>@Model.Description</textarea>
            </div>
        </div>

        <div class="card-footer">
            <button class="btn btn-danger">Delete</button>
        </div>
    </div>
</form>