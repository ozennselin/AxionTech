@using Core.Models.Entities.Category
@model CategoryResponseModel

@{
    ViewData["Title"] = "Update Category";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-warning">
    <div class="card-header">
        <h3 class="card-title">Update Category</h3>
    </div>

    <form method="post" action="~/AdminPanel/CategoryAP/Update">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="card-body">

            <div class="row">

                <div class="col-md-2">

                    <div class="form-group mt-4">

                        <div class="custom-control custom-switch">

                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="isMainCategory"
                            @(Model.ParentId == 0 ? "checked" : "")>

                            <label class="custom-control-label"
                                   for="isMainCategory">

                                Main Category

                            </label>

                        </div>

                    </div>

                </div>

                <div class="col-md-10">

                    <div class="form-group">

                        <label>Parent Category</label>

                        <select id="parentCategorySelect"
                                name="ParentId"
                                class="form-control"
                            @(Model.ParentId == 0 ? "disabled" : "")>

                            <option value="0">
                                Select Parent Category
                            </option>

                            @foreach (var item in ViewBag.CategoryList)
                            {
                                if (item.ParentId == 0)
                                {
                                    <option value="@item.Id"
                                            selected="@(item.Id == Model.ParentId)">

                                        @item.Name

                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>

            </div>

            <div class="form-group">
                <label>Name</label>
                <input name="Name" value="@Model.Name" class="form-control" />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

        </div>

        <div class="card-footer">
            <button class="btn btn-warning">Update</button>
        </div>
    </form>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-2">@ViewBag.Error</div>
}
@section _js {

    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>

    <script src="~/js/categorySelectChose.js"></script>

}