@using Core.Models.Entities.Category
@model List<CategoryResponseModel>

@{
    ViewData["Title"] = "Category List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<h1>Category List</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">Kayıt bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>