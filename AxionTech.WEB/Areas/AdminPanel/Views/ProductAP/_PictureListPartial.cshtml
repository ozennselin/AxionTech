@using Core.Models.Entities.ProductPicture

@model List< ProductPictureResponseModel>

<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Picture List</h3>
        </div>

        <div class="row" id="resimList">
            @if (Model != null)
            {

                @foreach (var item in Model)
                {
                    <div class="col-sm-2" id="@item.Name">
                        <a href="#" data-toggle="lightbox" data-title="sample 1 - white" data-gallery="gallery">
                            <img src="~/picture/@item.Name" class="img-fluid mb-2 border rounded p-1" alt="white sample">
                        </a>
                        <div class="urun-sil">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button onclick="DeletePicture(@item.Id)" type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>
