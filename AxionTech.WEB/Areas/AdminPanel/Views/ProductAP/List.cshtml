@using Core.Models.Entities.Product

@{
    ViewData["Title"] = "List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

@model List<ProductResponseModel>
    <div class="card card-info">
        <div class="card-header">
        <div class="text-xl-left"> <h3 class="card-title">Product List</h3></div>
            <div class="text-md-right">
                <input type="button" class="btn btn-success" value="Create" />
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Category Name</th>
                        <th>Detail</th>
                        <th>Update</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td> @item.CategoryName</td>
                            <td><a class="btn btn-block btn-primary btn-sm"><i class="fa fa-eye"></i> </a></td>
                            <td>
                                <a class="btn btn-block btn-warning btn-sm"><i class="fa fa-pen"></i> </a>
                            </td>
                            <td><a class="btn btn-block btn-danger btn-sm"><i class="fa fa-pen"></i> </a></td>
                        </tr>
                    }

                </tbody>
                <tfoot>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Category Name</th>
                        <th>Detail</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
