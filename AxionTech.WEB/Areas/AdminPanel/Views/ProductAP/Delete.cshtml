@using Core.Models.Entities.Product
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@model ProductResponseModel

<form asp-area="AdminPanel" asp-controller="ProductAP" asp-action="Delete" method="post">
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Delete</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>ProductId</label>
                        <input  class="form-control" name="Id" type="text" value="@Model.Id" disabled >
                        <label> Description</label>
                        <input class="form-control" name="description" type="text" value="@Model.Description" disabled>

                    </div>
                    <!-- /.card-body -->
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Product Name</label>
                        <input class="form-control" type="text" name="name" value=" @Model.Name" />
                        <label> Category Name</label>
                        <input class="form-control" type="text" name="categoryname" value="@Model.CategoryName" />
                    </div>
                </div>
                <input type="submit" class="btn btn-danger" value="Delete" />

            </div>
        </div>
    </div>
</form>