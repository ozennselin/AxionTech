@using Core.Models.Entities.Product
@{
    ViewData["Title"] = "Update";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@section _css {
    <link rel="stylesheet" href="~/dropzone/dropzone.min.css" />
    @* <link rel="stylesheet" href="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone.css" /> *@
}
@model ProductCreateUpdateResponseModel

@* <form action="~/AdminPanel/ProductAP/Update"  method="post" > *@
<form asp-area="AdminPanel" asp-controller="ProductAP" asp-action="Update" method="post">
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Detail</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>ProductId</label>
                        <input class="form-control" name="id" type="text" value="@Model.ProductDetail.Id" disabled>
                        <label> Description</label>
                        <input class="form-control" name="description" type="text" value="@Model.ProductDetail.Description">

                    </div>
                    <!-- /.card-body -->
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Product Name</label>
                        <input class="form-control" type="text" name="name" value=" @Model.ProductDetail.Name" />
                        <label> Category Name</label>
                        <input class="form-control" type="text" name="categoryname" value="@Model.ProductDetail.CategoryName" />
                    </div>
                </div>
                <input type="submit" class="btn btn-success" value="Update" />

            </div>
        </div>
    </div>
</form>
@* 2-product price info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Price</h3>
        </div>

    </div>
</div>

@* 3-product picture info *@

@Html.Partial("_PicturePartial", null)
@Html.Partial("_PictureListPartial", Model.ProductPicture)


@* 4- product document info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Document</h3>
        </div>

    </div>
</div>



