@using Core.Models.Entities.Product
@{
    ViewData["Title"] = "Update";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@section _css {
    <style>
        .sil-btn{
            position: absolute;
            top: 0px;
            right: 8px;
        }
    </style>
    <link rel="stylesheet" href="~/dropzone/dropzone.min.css" />
    @* <link rel="stylesheet" href="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone.css" /> *@
}
@model ProductCreateUpdateResponseModel

@* <form action="~/AdminPanel/ProductAP/Update"  method="post" > *@
<form asp-area="AdminPanel" asp-controller="ProductAP" asp-action="Update" method="post">
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Detail</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>ProductId</label>
                        <input class="form-control" name="id" type="text" value="@Model.ProductDetail.Id" disabled>
                        <label> Description</label>
                        <input class="form-control" name="description" type="text" value="@Model.ProductDetail.Description">

                    </div>
                    <!-- /.card-body -->
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Product Name</label>
                        <input class="form-control" type="text" name="name" value=" @Model.ProductDetail.Name" />
                        <label> Category Name</label>
                        <input class="form-control" type="text" name="categoryname" value="@Model.ProductDetail.CategoryName" />
                    </div>
                </div>
                <input type="submit" class="btn btn-success" value="Update" />

            </div>
        </div>
    </div>
</form>
@* 2-product price info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Price</h3>
        </div>
        <div class="card-body">
            <div class="row mb-4 border-bottom pb-3">
                <div class="col-md-5">
                    <label>Fiyat (₺)</label>
                    <input type="number" id="newPrice" class="form-control" placeholder="0.00">
                </div>
                <div class="col-md-5">
                    <label>Açıklama</label>
                    <input type="text" id="newPriceDesc" class="form-control" placeholder="Örn: Liste Fiyatı, İndirimli vb.">
                </div>
                <div class="col-md-2">
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-success btn-block" onclick="SavePrice()">Ekle</button>
                </div>
            </div>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr class="bg-light text-center">
                        <th>Fiyat</th>
                        <th>Açıklama</th>
                        <th style="width: 100px;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="priceListTable">
                    @if (Model.ProductPrice != null && Model.ProductPrice.Any())
                    {
                        foreach (var item in Model.ProductPrice)
                        {
                            <tr id="price-row-@item.Id">
                                <td class="text-center"><strong>@item.Price.ToString("N2") ₺</strong></td>
                                <td>@item.Description</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-danger btn-xs" onclick="RemovePrice(@item.Id)">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="no-price-msg">
                            <td colspan="3" class="text-center text-muted">Henüz bir fiyat tanımlanmamış.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* 3-product picture info *@

@Html.Partial("_PicturePartial", null)
@Html.Partial("_PictureListPartial", Model.ProductPicture)


@* 4- product document info *@

@Html.Partial("_DocumentPartial", null)
@if (Model.ProductDocument != null)
{
    @Html.Partial("_DocumentListPartial", Model.ProductDocument)
}
else
{
    @Html.Partial("_DocumentListPartial", new List<Core.Models.Entities.ProductDocument.ProductDocumentResponseModel>())
}


@section _js {
    <script src="~/adminlte/docs/assets/plugins/jquery/jquery.min.js"></script>
    <script src="~/dropzone/dropzone.min.js"></script>
    <script src="~/js/insertpicture.js" ></script>
    <script src="~/js/deletepicture.js"></script>
    <script src="~/js/insertdocument.js"></script>
    <script src="~/js/insertprice.js"></script>
}