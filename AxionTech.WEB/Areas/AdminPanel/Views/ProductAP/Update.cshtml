@using Core.Models.Entities.Product
@{
    ViewData["Title"] = "List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@section _css{
    <link href="~/dropzone/dropzone.min.css" rel="stylesheet" />
}

@model ProductCreateUpdateResponseModel

@* <form action="~/AdminPanel/ProductAP/Update"  method="post" > *@
<form asp-area="AdminPanel" asp-controller="ProductAP" asp-action="Update"  method="post" >
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Detail</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>ProductId</label>
                        <input class="form-control" name="id" type="text" value="@Model.ProductDetail.Id" disabled>
                        <label> Description</label>
                        <input class="form-control" name="description" type="text" value="@Model.ProductDetail.Description">

                    </div>
                    <!-- /.card-body -->
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Product Name</label>
                        <input class="form-control" type="text" name="name" value=" @Model.ProductDetail.Name" />
                        <label> Category Name</label>
                        <input class="form-control" type="text" name="categoryname" value="@Model.ProductDetail.CategoryName" />
                    </div>
                </div>
                <input type="submit" class="btn btn-success"  value="Update" />

            </div>
        </div>
    </div>
</form>
@* 2-product price info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Price</h3>
        </div>

    </div>
</div>

@* 3-product picture info *@

@Html.Partial("_PicturePartial", null)
@Html.Partial("_PictureListPartial",Model.ProductPicture)

@* 4- product document info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Document</h3>
        </div>

    </div>
</div>

@section _js{

<script src="~/dropzone/dropzone.min.js"></script>
    <script>
        debugger;
        Dropzone.option.myDropzone={
            paramName:"file",//Controller method parametresi ile aynı isimde olmalı
            maxFileSize:5,
            acceptedFiles:".jpg,.jpeg,.png,.gif",
            autoProcessQueue:false,
            parallelUploads:10,
            init: function(){
                var submitButton=document.querySelector("#submit-all");

               var myDropzone=this;

               submitButton.addEventListener("click", function(){
                   myDropzone.autoProcessQueue();//button basınca yükleme başlasın


               });
               this.on ("success",function(file, response){
               console.log("Resimler başarılı bir şekilde yüklendi",response);
               
               });

                   this.on ("failed",function(file, response){
               console.log("Resimler  yüklenemedi",response);

               })

            }



        }

    </script>


}