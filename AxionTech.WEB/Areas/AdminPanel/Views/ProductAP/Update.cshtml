@using Core.Models.Entities.Product
@{
    ViewData["Title"] = "List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@model ProductResponseModel

@* <form action="~/AdminPanel/ProductAP/Update"  method="post" > *@
<form asp-area="AdminPanel" asp-controller="ProductAP" asp-action="Update"  method="post" >
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Detail</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>ProductId</label>
                        <input class="form-control" name="id" type="text" value="@Model.Id" disabled>
                        <label> Description</label>
                        <input class="form-control" name="description" type="text" value="@Model.Description">

                    </div>
                    <!-- /.card-body -->
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Product Name</label>
                        <input class="form-control" type="text" name="name" value=" @Model.Name" />
                        <label> Category Name</label>
                        <input class="form-control" type="text" name="categoryname" value="@Model.CategoryName" />
                    </div>
                </div>
                <input type="submit" class="btn btn-success"  value="Update" />

            </div>
        </div>
    </div>
</form>
@* 2-product price info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Price</h3>
        </div>

    </div>
</div>

@* 3-product picture info *@

@* @Html.Partial("_ProductPicturePartial",null) *@
<partial name="_ProductPicturePartial" model="" />

@* 4- product document info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Document</h3>
        </div>

    </div>
</div>