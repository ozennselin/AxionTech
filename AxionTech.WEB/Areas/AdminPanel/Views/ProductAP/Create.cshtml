@using Core.Models.Entities.Product
@{
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}


@model ProductCreateUpdateResponseModel

@* 1-Product info *@
<!-- right column -->
<form method="post" action="~/AdminPanel/ProductAP/Create">
    <div class="col-md-12">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Product Detail</h3>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label for="productName" class="form-label">Product Name</label>
                        <input id="productName" name="Name" class="form-control" type="text" placeholder="Product Name">

                        <label for="categoryId" class="form-label">Category Name</label>
                        <!--Kategori doldurma alanı-->
                        @Html.Partial("_CategoryList", Model.Category)
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="card-body">
                        <label> Description</label>
                        @* <input class="form-control" type="text" placeholder="Description"> *@
                        <textarea name="description" class="form-control" type="text" rows="4" placeholder="Description"></textarea>
                    </div>
                </div>
            </div>
            <p class="danger">@ViewBag.error</p>
        </div>
        <button class="btn btn-success">Create</button>
    </div>
</form>


@* 2-product price info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Price</h3>
        </div>
        <div class="card-body">
            <p class="text-muted"><i class="fas fa-info-circle"></i> Ürün fiyatlandırma işlemini, ürünü oluşturduktan sonra <b>Update</b> ekranından yapabilirsiniz.</p>
        </div>
    </div>
</div>

@* 3-product picture info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Picture</h3>
        </div>
        <div class="card-body">
            <p class="text-muted"><i class="fas fa-image"></i> Ürün görsellerini, ürünü oluşturduktan sonra <b>Update</b> ekranından yükleyebilirsiniz.</p>
        </div>
    </div>
</div>

@* 4- product document info *@
<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Document</h3>
        </div>
        <div class="card-body">
            <p class="text-muted"><i class="fas fa-file-pdf"></i> Ürün dökümanlarını, ürünü oluşturduktan sonra <b>Update</b> ekranından ekleyebilirsiniz.</p>
        </div>
    </div>
</div>

@section _js {
    <script src="~/igtu/js/jquery-3.2.1.min.js"></script>
    <script type="text/javascript">
         //Parent Id değeri o olmayan bağlı kategorileri getirmek için kullanılacak


         $(document).ready(function(){
        
                    $("#categoryContainer").on('change','#categoryId',function(){
                    // $("#categoryContainer").on('change','#categoryId',function(){/categoryId yerine class vererek çalışmak gerekli

                              var selectedCategoryId=$(this);
                               var parentId=selectedCategoryId.val();

                          //C# taafında seçilen kategori için alt kategorileri getirecek Controller methoda yönlendirme
                          $.ajax({
                                  url:"/CategoryAP/GetChildCategoryWithId",
                                  type:"GET",
                                  data:{categoryId:parentId},
                                  success:function(response) {
                                    //data=> birden fazla kategori getirecek

                                    var nextCategoryLevel=parseInt( parentId)+1;

                                           var html=`<div class="category-level" >
                                        <select class="form-control" data-level="${nextCategoryLevel}">
                                            <option value="">Altkategori Seçiniz!!</option>`;


                                        $.each(response.data,function (index,item){
                                            html+=`<option value="${item.id}">${item.name}</option>"`;                    
                                        });

                                        html+=` </select></div>`;

                                        $("#categoryContainer").append(html);


                                              //success SON
                                   },
                                     error:function(hata) {
                                         console.log("hata:"+hata.responseText)
                                     }
                          });                        

                  });
        });
    </script>
}
