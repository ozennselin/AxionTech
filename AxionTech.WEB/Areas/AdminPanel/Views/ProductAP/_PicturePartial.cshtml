@* @using Core.Models.Entities.ProductPicture

@model List<ProductPictureResponseModel> *@

<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Product Picture</h3>
        </div>
        <form action="~/AdminPanel/ProductAP/Upload" class="dropzone" id="myDropzone" enctype="multipart/form-data">
            <div class="dz-message">
                <h4>Resimleri sürükleyin veya tıklayarak yükleyin</h4>
                <input type="hidden" value="2" name="productId" id="productId" />
            </div>
        </form>
        <button type="button" id="resimYukle" class="btn btn-success">Resim Yükle</button>

    </div>
</div>
