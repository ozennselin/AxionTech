@using Core.Models.Entities.Order
@model List<OrderResponseModel>

@{
    ViewData["Title"] = "Order List";
    Layout = "/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<h1>Order List</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Order No</th>
            <th>Order Date</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Address</th>
            <th>User Id</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderNo</td>
                    <td>@item.OrderDate</td>
                    <td>@item.TotalAmount</td>
                    <td>@item.Status</td>
                    <td>@item.Address</td>
                    <td>@item.UserId</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">Kayıt bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>