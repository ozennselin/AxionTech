@using Core.Models.Entities.Order
@model List<OrderResponseModel>

@{
    ViewData["Title"] = "Order List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <h3 class="card-title">Order List</h3>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Order No</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Address</th>
                    <th>User Id</th>
                    <th>Detail</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.OrderNo</td>
                            <td>@item.OrderDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.TotalAmount</td>
                            <td>@item.Status</td>
                            <td>@item.Address</td>
                            <td>@item.UserId</td>

                            <td>
                                <a class="btn btn-block btn-primary btn-sm"
                                   href="~/AdminPanel/OrderAP/Detail/@item.Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-danger">
                            No records found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>