@using Core.Models.Entities.Cart
@model CartResponseModel

@{
    ViewData["Title"] = "Update Cart";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<form asp-area="AdminPanel" asp-controller="CartAP" asp-action="Update" method="post">
    <div class="col-md-12">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Cart Detail</h3>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card-body">
                        <label>Cart Id</label>
                        <input class="form-control" type="text" value="@Model.Id" disabled />
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <label>Customer</label>
                        <input class="form-control" name="UserId" type="text" value="@Model.UserId" />
                        <small class="text-muted">Customer is currently shown by User Id.</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card-body">
                        <label>Total Items</label>
                        <input class="form-control" type="text" value="@(Model.Items != null ? Model.Items.Count : 0)" disabled />

                        <label>Total Amount</label>
                        <input class="form-control" type="text" value="@(Model.Items != null ? Model.Items.Sum(x => x.LineTotal) : 0) ₺" disabled />
                    </div>
                </div>

                <div class="col-md-12 p-3">
                    <input type="submit" class="btn btn-success" value="Update" />
                    <a href="~/AdminPanel/CartAP/List" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Cart Items</h3>
        </div>

        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice ₺</td>
                                <td>@item.LineTotal ₺</td>
                                <td>
                                    <a class="btn btn-danger btn-sm"
                                       href="~/AdminPanel/CartItemAP/Delete/@item.Id">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-danger">
                                Sepette ürün yok
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>