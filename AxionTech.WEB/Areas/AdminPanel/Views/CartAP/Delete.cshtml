@using Core.Models.Entities.Cart
@model CartResponseModel

@{
    ViewData["Title"] = "Delete Cart";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="col-md-12">
    <div class="card card-danger">
        <div class="card-header">
            <h3 class="card-title">Delete Cart</h3>
        </div>

        <div class="card-body">
            <label>Cart Id</label>
            <input class="form-control" value="@Model.Id" disabled />

            <label>Customer</label>
            <input class="form-control" value="User #@Model.UserId" disabled />

            <br />

            <form method="post" asp-action="Delete">
                <input type="hidden" name="Id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a href="~/AdminPanel/CartAP/List" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>