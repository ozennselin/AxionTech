@using Core.Models.Entities.Cart
@model List<CartResponseModel>

@{
    ViewData["Title"] = "Cart List";
    Layout = "/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="text-xl-left">
            <h3 class="card-title">Cart List</h3>
        </div>
        <div class="text-md-right">
            <a class="btn btn-success" href="#">Createee</a>
        </div>
    </div>

    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>User Id</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserId</td>
                        </tr>

                        @if (item.Items != null && item.Items.Any())
                        {
                            <tr>
                                <td colspan="2">
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Product Id</th>
                                                <th>Quantity</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ci in item.Items)
                                            {
                                                <tr>
                                                    <td>@ci.ProductName</td>
                                                    <td>@ci.UnitPrice</td>
                                                    <td>@ci.Quantity</td>
                                                    <td>@ci.LineTotal</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <th>Id</th>
                    <th>User Id</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>