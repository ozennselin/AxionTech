@using Core.Models.Entities.Cart
@model List<CartResponseModel>

@{
    ViewData["Title"] = "Cart List";
    Layout = "/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="text-xl-left">
            <h3 class="card-title">Cart List</h3>
        </div>
        <div class="text-md-right">
            <a class="btn btn-success" href="~/AdminPanel/CartAP/Create">Createee</a>
        </div>
    </div>

    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>User Id</th>
                    <th>Detail</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserId</td>
                            <td></td>
                            <td><a class="btn btn-block btn-primary btn-sm" href="~/AdminPanel/CartAP/Detail/@item.Id"><i class="fa fa-eye"></i></a></td>
                            <td><a class="btn btn-block btn-warning btn-sm" href="~/AdminPanel/CartAP/Update/@item.Id"><i class="fa fa-pen"></i></a></td>
                            <td><a class="btn btn-block btn-danger btn-sm" href="~/AdminPanel/CartAP/Delete/@item.Id"><i class="fa fa-trash"></i></a></td>
                            
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-danger">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>