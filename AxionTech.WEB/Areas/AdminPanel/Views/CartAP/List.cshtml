@using Core.Models.Entities.Cart
@model List<CartResponseModel>

@{
    ViewData["Title"] = "Cart List";
    Layout = "/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="text-xl-left">
            <h3 class="card-title">Cart List</h3>
        </div>
        <div class="text-md-right">
            <a class="btn btn-success" href="~/AdminPanel/CartAP/Create">Create</a>
        </div>
    </div>

    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Cart No</th>
                    <th>Customer</th>
                    <th>Products</th>
                    <th>Total Items</th>
                    <th>Total Amount</th>
                    <th>Detail</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var itemCount = item.Items != null ? item.Items.Count : 0;
                        decimal totalPrice = item.Items != null ? item.Items.Sum(x => x.LineTotal) : 0;

                        <tr>
                            <td>@item.Id</td>
                            <td>User #@item.UserId</td>

                            <td>
                                @(item.Items != null && item.Items.Any()
                                                        ? string.Join(", ", item.Items.Select(x => x.ProductName))
                                                        : "No product")
                            </td>

                            <td>@itemCount</td>
                            <td>@totalPrice ₺</td>

                            <td>
                                <a class="btn btn-block btn-primary btn-sm" href="~/AdminPanel/CartAP/Detail/@item.Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-warning btn-sm" href="~/AdminPanel/CartAP/Update/@item.Id">
                                    <i class="fa fa-pen"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-danger btn-sm" href="~/AdminPanel/CartAP/Delete/@item.Id">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-danger">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>