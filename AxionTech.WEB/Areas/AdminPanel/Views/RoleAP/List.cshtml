@using Core.Models.Entities.Role
@model List<RoleResponseModel>

@{
    ViewData["Title"] = "Role List";
    Layout = "/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<h1>Role List</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2">Kayıt bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>