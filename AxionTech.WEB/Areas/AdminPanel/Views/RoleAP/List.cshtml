@using Core.Models.Entities.Role
@model List<RoleResponseModel>

@{
    ViewData["Title"] = "Role List";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <h3 class="card-title">Role List</h3>
            <a class="btn btn-success" href="~/AdminPanel/RoleAP/Create">Create</a>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Role Name</th>
                    <th>Description</th>
                    <th>User Count</th>
                    <th>Status</th>
                    <th>Detail</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><b>@item.Name</b></td>
                            <td>@item.Description</td>
                            <td>@item.UserCount</td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Passive</span>
                                }
                            </td>

                            <td>
                                <a class="btn btn-block btn-primary btn-sm"
                                   href="~/AdminPanel/RoleAP/Detail/@item.Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-warning btn-sm"
                                   href="~/AdminPanel/RoleAP/Update/@item.Id">
                                    <i class="fa fa-pen"></i>
                                </a>
                            </td>

                            <td>
                                <a class="btn btn-block btn-danger btn-sm"
                                   href="~/AdminPanel/RoleAP/Delete/@item.Id">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-danger">
                            No records found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>