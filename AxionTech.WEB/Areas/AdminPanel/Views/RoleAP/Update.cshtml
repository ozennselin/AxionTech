@using Core.Models.Entities.Role
@model RoleUpdatePageResponseModel

@{
    ViewData["Title"] = "Update Role";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-warning">
    <div class="card-header">
        <h3 class="card-title">Update Role</h3>
    </div>

    <form method="post" action="~/AdminPanel/RoleAP/Update">
        <input type="hidden" name="Id" value="@Model.Role.Id" />

        <div class="card-body">

            <div class="form-group">
                <label>Role Name</label>
                <input name="Name" value="@Model.Role.Name" class="form-control" />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Role.Description</textarea>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select name="IsActive" class="form-control">
                    <option value="true" @(Model.Role.IsActive ? "selected" : null)>Active</option>
                    <option value="false" @(!Model.Role.IsActive ? "selected" : null)>Passive</option>
                </select>
            </div>

            <div class="form-group">
                <label>User Count</label>
                <input value="@Model.Role.UserCount" class="form-control" disabled />
            </div>

        </div>
        <div class="form-group">

            <label>Menus</label>

            @foreach (var menu in Model.Menus)
            {
                var isChecked = Model.SelectedMenuIds.Contains(menu.Id);

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           name="MenuIds"
                           value="@menu.Id"
                           checked="@isChecked" />

                    <label class="form-check-label">

                        @menu.ControllerName
                        -
                        @menu.ViewName

                    </label>

                </div>
            }

        </div>

        <div class="card-footer">
            <button class="btn btn-warning">Update</button>
        </div>
    </form>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-2">@ViewBag.Error</div>
}