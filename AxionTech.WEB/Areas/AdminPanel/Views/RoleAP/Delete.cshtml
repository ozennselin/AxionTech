@using Core.Models.Entities.Role
@model RoleDeletePageResponseModel

@{
    ViewData["Title"] = "Delete Role";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<form method="post" action="~/AdminPanel/RoleAP/Delete">
    <input type="hidden" name="Id" value="@Model.Role.Id" />

    <div class="card card-danger">
        <div class="card-header">
            <h3 class="card-title">Delete Role</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                ⚠️ Deleting this role may affect users assigned to it!
            </div>

            <div class="form-group">
                <label>Role Name</label>
                <input class="form-control" value="@Model.Role.Name" disabled />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea class="form-control" rows="3" disabled>@Model.Role.Description</textarea>
            </div>

            <div class="form-group">
                <label>User Count</label>
                <input class="form-control" value="@Model.Role.UserCount" disabled />
            </div>

        </div>
        <div class="form-group">

            <label>Menus</label>

            @foreach (var menu in Model.Menus)
            {
                var isChecked = Model.SelectedMenuIds.Contains(menu.Id);

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           value="@menu.Id"
                           checked="@isChecked"
                           disabled />

                    <label class="form-check-label">
                        @menu.ControllerName - @menu.ViewName
                    </label>

                </div>
            }

        </div>

        <div class="card-footer">
            <button class="btn btn-danger">Delete</button>
        </div>
    </div>
</form>