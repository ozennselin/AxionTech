@using Core.Enums
@using Core.Models.Entities.Menu

@model List<MenuResponseModel>

@{
    var selectedMenuIds = ViewData["SelectedMenuIds"] as List<int> ?? new List<int>();
}

<table class="table table-bordered table-hover text-center">
    <thead class="table-light">
        <tr>
            <th class="text-start">Modül</th>
            <th>List</th>
            <th>Create</th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        @foreach (MenuEnum item in Enum.GetValues(typeof(MenuEnum)))
        {
            var controllerName = item.ToString() + "AP";

            var listMenu = Model?.FirstOrDefault(x => x.ControllerName == controllerName && x.ViewName == "List");
            var createMenu = Model?.FirstOrDefault(x => x.ControllerName == controllerName && x.ViewName == "Create");
            var updateMenu = Model?.FirstOrDefault(x => x.ControllerName == controllerName && x.ViewName == "Update");
            var deleteMenu = Model?.FirstOrDefault(x => x.ControllerName == controllerName && x.ViewName == "Delete");

            <tr>
                <td class="text-start">
                    <strong>@item</strong>
                </td>

                <td>
                    <input type="checkbox"
                           name="MenuIds"
                           value="@(listMenu?.Id ?? 0)"
                           class="form-check-input"
                           checked="@(listMenu != null && selectedMenuIds.Contains(listMenu.Id))" />
                </td>

                <td>
                    <input type="checkbox"
                           name="MenuIds"
                           value="@(createMenu?.Id ?? 0)"
                           class="form-check-input"
                           checked="@(createMenu != null && selectedMenuIds.Contains(createMenu.Id))" />
                </td>

                <td>
                    <input type="checkbox"
                           name="MenuIds"
                           value="@(updateMenu?.Id ?? 0)"
                           class="form-check-input"
                           checked="@(updateMenu != null && selectedMenuIds.Contains(updateMenu.Id))" />
                </td>

                <td>
                    <input type="checkbox"
                           name="MenuIds"
                           value="@(deleteMenu?.Id ?? 0)"
                           class="form-check-input"
                           checked="@(deleteMenu != null && selectedMenuIds.Contains(deleteMenu.Id))" />
                </td>
            </tr>
        }
    </tbody>
</table>