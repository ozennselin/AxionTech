@using Core.Models.Entities.MenuRole
@model MenuRoleCreatePageResponseModel

@{
    ViewData["Title"] = "Menu Role Create";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="card card-info">

    <div class="card-header">

        <h3 class="card-title">
            Menu Role Assignment
        </h3>

    </div>

    <form method="post">

        <div class="card-body">

            <div class="form-group">

                <label>Role</label>

                <select class="form-control"
                        name="RoleId">

                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">
                            @role.Name
                        </option>
                    }

                </select>

            </div>

            <div class="form-group">

                <label>Menus</label>

                @foreach (var menu in Model.Menus)
                {
                    <div class="form-check">
                        @{
                            var isChecked = Model.SelectedMenuIds != null && Model.SelectedMenuIds.Contains(menu.Id);
                        }

                        <input class="form-check-input"
                               type="checkbox"
                               name="MenuIds"
                               value="@menu.Id"
                               checked="@isChecked" />

                        <label class="form-check-label">

                            @menu.ControllerName
                            -
                            @menu.ViewName

                        </label>

                    </div>
                }

            </div>

        </div>

        <div class="card-footer">

            <button class="btn btn-success">
                Save
            </button>

        </div>

    </form>

</div>