@using Core.Models.Entities.Dashboard
@model DashboardResponseModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}


    <section class="content-header">
        <div class="container-fluid">
            <h1>Dashboard</h1>
        </div>
    </section>

    <section class="content">
      <div class="container-fluid">

         <div class="row">

            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">

                    <div class="inner">
                        <h3>@Model.ProductCount</h3>
                        <p>Ürün Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-box"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">

                    <div class="inner">
                        <h3>@Model.OrderCount</h3>
                        <p>Sipariş Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">

                    <div class="inner">
                        <h3>@Model.UserCount</h3>
                        <p>Kullanıcı Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">

                    <div class="inner">
                        <h3>@Model.CartCount</h3>
                        <p>Aktif Sepet</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-shopping-bag"></i>
                    </div>

                </div>
            </div>

         </div>
      </div>
    <div class="row">

        <section class="col-lg-12">

            <div class="card">

                <div class="card-header">
                    <h3 class="card-title">
                        Aylık Satış Grafiği
                    </h3>
                </div>

                <div class="card-body">

                    <canvas id="salesChart"
                            style="min-height: 250px; height: 250px;">
                    </canvas>

                </div>

            </div>

        </section>

    </div>

    </section>
</section>

@section _js {

    <script src="~/adminlte/plugins/chart.js/Chart.min.js"></script>

    <script>
        var monthlySales = @Html.Raw(Json.Serialize(Model.MonthlySales));
    </script>

    <script src="~/js/dashboard.js"></script>

}

