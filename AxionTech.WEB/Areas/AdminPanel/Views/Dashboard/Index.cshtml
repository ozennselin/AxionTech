@using Core.Models.Entities.Dashboard
@model DashboardResponseModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}
@section _css {
    <link rel="stylesheet"
          href="~/adminlte/plugins/jqvmap/jqvmap.css" />
}


<section class="content-header">
    <div class="container-fluid">
        <h1>Dashboard</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="row">

            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">

                    <div class="inner">
                        <h3>@Model.ProductCount</h3>
                        <p>Ürün Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-box"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">

                    <div class="inner">
                        <h3>@Model.OrderCount</h3>
                        <p>Sipariş Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">

                    <div class="inner">
                        <h3>@Model.UserCount</h3>
                        <p>Kullanıcı Sayısı</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-users"></i>
                    </div>

                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">

                    <div class="inner">
                        <h3>@Model.CartCount</h3>
                        <p>Aktif Sepet</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-shopping-bag"></i>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="row">

        <section class="col-lg-12">

            <div class="card">

                <div class="card-header">
                    <h3 class="card-title">
                        Aylık Satış Grafiği
                    </h3>
                </div>

                <div class="card-body">

                    <canvas id="salesChart"
                            style="min-height: 250px; height: 250px;">
                    </canvas>

                </div>

            </div>

        </section>

    </div>
    <div class="row mt-4">

        <div class="col-lg-12">

            <div class="card">

                <div class="card-header">
                    <h3 class="card-title">Son Siparişler</h3>
                </div>

                <div class="card-body p-0">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Sipariş No</th>
                                <th>Tarih</th>
                                <th>Tutar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.LastOrders)
                            {
                                <tr>
                                    <td>@item.OrderNo</td>
                                    <td>@item.OrderDate.ToShortDateString()</td>
                                    <td>@item.TotalAmount ₺</td>
                                    <td>
                                        @{
                                            var badgeClass = item.Status switch
                                            {
                                                "Pending" => "badge badge-warning",
                                                "Completed" => "badge badge-success",
                                                "Cancelled" => "badge badge-danger",
                                                _ => "badge badge-secondary"
                                            };
                                        }

                                        <span class="@badgeClass">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
    <div class="row mt-4">

        <section class="col-lg-12">

            <div class="card bg-gradient-primary">

                <div class="card-header border-0">
                    <h3 class="card-title">
                        <i class="fas fa-map-marker-alt mr-1"></i>
                        Türkiye Sipariş Haritası
                    </h3>
                </div>

                <div class="card-body">

                    <div id="turkey-map" style="height: 400px; width: 100%;"></div>

                </div>

                <div class="card-footer bg-transparent">
                    <div class="row">

                        <div class="col-4 text-center">
                            <div class="text-white">
                                <strong>İstanbul</strong>
                                <br />
                                <span>120 Sipariş</span>
                            </div>
                        </div>

                        <div class="col-4 text-center">
                            <div class="text-white">
                                <strong>Ankara</strong>
                                <br />
                                <span>75 Sipariş</span>
                            </div>
                        </div>

                        <div class="col-4 text-center">
                            <div class="text-white">
                                <strong>İzmir</strong>
                                <br />
                                <span>48 Sipariş</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </section>

    </div>
</section>

@section _js {

    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>

    <script src="~/adminlte/plugins/chart.js/Chart.min.js"></script>

    <script>
        var monthlySales = @Html.Raw(Json.Serialize(Model.MonthlySales));
    </script>

    <script src="~/adminlte/plugins/jqvmap/jquery.vmap.js"></script>
    <script src="~/adminlte/plugins/jqvmap/maps/jquery.vmap.turkey.js"></script>

    <script src="~/js/dashboard.js"></script>

}

