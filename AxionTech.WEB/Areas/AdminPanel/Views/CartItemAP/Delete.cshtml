@using Core.Models.Entities.CartItem
@model CartItemResponseModel

@{
    ViewData["Title"] = "Delete Cart Item";
    Layout = "~/Areas/AdminPanel/Views/Shared/_LayoutAP.cshtml";
}

<div class="col-md-12">
    <div class="card card-danger">
        <div class="card-header">
            <h3 class="card-title">Delete Cart Item</h3>
        </div>

        <div class="card-body">
            <label>Product Name</label>
            <input class="form-control" value="@Model.ProductName" disabled />

            <label>Quantity</label>
            <input class="form-control" value="@Model.Quantity" disabled />

            <label>Total</label>
            <input class="form-control" value="@Model.LineTotal ₺" disabled />

            <br />

            <form method="post" asp-action="Delete">
                <input type="hidden" name="Id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>